{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wilson-dev",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  // The deploy pipeline runs `npx wrangler deploy` with NO build step, so the
  // assets directory must exist on a fresh clone. The site lives at the repo
  // root; .assetsignore excludes node_modules (workerd alone is 128 MiB and
  // exceeds Cloudflare's 25 MiB per-asset limit) and other dev-only files.
  // For a clean standalone bundle (e.g. Pages), `npm run build` makes dist/.
  "assets": {
    "directory": "."
  }
}
